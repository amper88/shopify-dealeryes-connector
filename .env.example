# Shopify App credentials — from the Partner Dashboard → App → Settings → Credentials
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://your-render-app.onrender.com"
SCOPES="read_products,write_products,read_customers,write_customers,read_companies,write_companies,read_price_rules,write_price_rules,read_markets,write_markets,read_publications"

# DealerYes connection — from Settings → Shopify Integration in DealerYes
DEALERYES_URL="https://acme.dealeryes.com"
DEALERYES_WEBHOOK_URL="https://acme.dealeryes.com/webhook/shopify"
DEALERYES_INSTALL_URL="https://acme.dealeryes.com/webhook/shopifyinstall"
# Must match webhook_shared_secret in conf/shopify.ini on the DealerYes server
# Generate: openssl rand -hex 32
DEALERYES_WEBHOOK_SECRET=""
